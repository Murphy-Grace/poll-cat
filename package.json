{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "start": "node --env-file-if-exists=.env.local server/start.ts",
    "test:news": "node --test server/guardian.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.mjs server/*.test.mjs",
    "test:results": "node --test src/civic.test.mjs src/election.test.mjs src/senate.test.mjs"
  },
  "dependencies": {
    "@svg-maps/usa": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
